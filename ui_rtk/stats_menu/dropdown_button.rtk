panel DropDownButton
{
	anchor: TOP_LEFT
	pivot: <0, 0>
	size: <450, 55>
	inputListener: true

	behavior Button
	{
		soundHighlighted: "ui_menu_focus"
		transitions: [
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Gradient:Image.color
				value: <0.72, 0.73, 0.76, 0.25>
			},
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Glow:Image.alpha
				value: 0
			},
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.assetPath
				value: $"ui_image/rui/borders/border_outline_1px.rpak"
			},
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.color
				value: <0.72, 0.73, 0.76, 1.0>
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Gradient:Image.color
				value: <1.0, 0.31, 0.11, 0.25>
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Glow:Image.alpha
				value: 1.0
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.assetPath
				value: $"ui_image/rui/borders/border_outline_4px.rpak"
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.color
				value: <1.0, 0.31, 0.11, 1.0>
			},
			{
				fromState: ANY
				toState: NON_INTERACTIVE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Gradient:Image.color
				value: <0.72, 0.73, 0.76, 0>
			},
			{
				fromState: ANY
				toState: PRESSED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Glow:Image.alpha
				value: 0
			},
			{
				fromState: ANY
				toState: PRESSED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.assetPath
				value: $"ui_image/rui/borders/border_outline_1px.rpak"
			},
			{
				fromState: ANY
				toState: PRESSED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Border:Image.color
				value: <0.72, 0.73, 0.76, 1.0>
			}
		]
	}

	panel Background
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		
		behavior Image
		{
			color: <0.25, 0.25, 0.25, 1.0>
		}
	}

	panel Gradient
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		
		behavior Image
		{
			assetPath: $"ui_image/rui/gradient_ud_compressed.rpak"
		}
	}

	panel Glow
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		
		behavior Image
		{
			assetPath: $"ui_image/rui/borders/border_inner_glow.rpak"
			color: <1.0, 0.31, 0.11, 0>
		}
	}

	panel Border
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
	}

	panel Label
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		
		behavior Label
		{
			text: "Label"
			face: "TitleRegularFont"
			pixelHeight: 24
			color: #FFFFFFFF
			textAlignHorizontal: LEFT
			textAlignVertical: CENTER
			horizontalMode: SQUISH_TO_CONTAINER
			margin: <22, 22, 0, 0>
			allCaps: true
			useLocaleDirection: true
		}

		behavior NxOverrides
		{
			overrides: [
				{
					propertyRef: @panel:Label.pixelHeight
					nxValue: 28
				},
				{
					propertyRef: @panel:Label.margin
					nxValue: <8,0,0,0>
				}
			]
		}
	}
}
