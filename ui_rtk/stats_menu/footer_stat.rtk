panel
{
	bind root

	size: <251, 29>
	anchor: CENTER

	behavior NxOverrides
	{
		overrides: [
			{
				propertyRef: @panel.size
				nxValue: <251, 84>
			}
		]
	}

	panel
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0,50,0,0>
		pivot: <0.5, 0.5>
		useLocaleDirection: true

		behavior Label
		{
			bind *.label -> @this.text

			text: ""
			face: "DefaultRegularFont"
			color: <0.58, 0.58, 0.58, 1>
			pixelHeight: 20
			textAlignHorizontal: LEFT
			useLocaleDirection: true
		}

		behavior NxOverrides
		{
			overrides: [
				{
					propertyRef: @panel:Label.pixelHeight
					nxValue: 35
				},
				{
					propertyRef: @panel:Label.textAlignVertical
					nxValue: 1 // CENTER
				},
				{
					propertyRef: @panel:Label.face
					nxValue: "DefaultBoldFont"
				}
			]
		}
	}

	panel
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0,0,0,0>
		pivot: <0.5, 0.5>

		behavior Label
		{
			bind *.value -> @this.text

			text: ""
			face: "TitleBoldFont"
			color: <1.0, 1.0, 1.0, 1>
			pixelHeight: 20
			textAlignHorizontal: RIGHT
			useLocaleDirection: true
		}

		behavior NxOverrides
		{
			overrides: [
				{
					propertyRef: @panel:Label.pixelHeight
					nxValue: 35
				},
				{
					propertyRef: @panel:Label.textAlignVertical
					nxValue: 1 // CENTER
				}
			]
		}
	}
}
