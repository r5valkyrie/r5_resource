panel HoldTooltip
{
	var calloutText @this/Content/Callout:Label.text
	var duration @this:Animator.tweenAnimations[0].tweens[1].duration

	anchor: CENTER
	pivot: <0.5, 0.5>

	behavior Animator
	{
		tweenAnimations: [
			{
				name: "FadeIn"
				tweens: [
					{
						property: @owner.panel/Content:RenderGroup.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.1
					},
					{
						property: @owner.panel/Content/Loading:Ellipse.arcMax
						startValue: 0.0
						endValue: 1.0
						duration: 0.4
					}
				]
			}
		]
	}

	behavior FitToContent

	panel Content
	{
		anchor: CENTER
		size: <64, 64>

		behavior RenderGroup
		{
			alpha: 0.0
		}

		panel Loading
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <0, 0, 0, 0>

			behavior Ellipse
			{
				interiorColor: #FFFFFF
				interiorAlpha: 0.6
			}
		}

		panel Callout
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <0, 0, 0, 0>

			behavior Label
			{
				pixelHeight: 56
				colorRGB: #ffffff
				textAlignHorizontal: CENTER
				textAlignVertical: CENTER

			}
		}
	}
}