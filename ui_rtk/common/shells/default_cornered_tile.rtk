panel DefaultCorneredTile
{
	bind root

	anchor: CENTER_STRETCH_WIDTH_HEIGHT
	offsets: <0, 0, 0, 0>

	panel Background
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			color: #000000
			alpha: 0.6
			assetPath: $"ui_image/rui/borders/border_jclb_mask.rpak"
		}
	}

	panel Outline
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			alpha: 0.6
			assetPath: $"ui_image/rui/borders/border_jclb.rpak"
		}
	}

	panel TopLeftDots
	{
		anchor: TOP_LEFT
		pivot: <0, 0>
		size: <300, 300>

		behavior Image
		{
			assetPath: $"ui_image/rui/borders/border_jclb_mask.rpak"
			assetMaskPath: $"ui_image/rui/menu/lobby/jclb_dots.rpak"
			alpha: 0.3
		}
	}

	panel BottomRightDots
	{
		anchor: BOTTOM_RIGHT
		pivot: <0, 0>
		size: <300, 300>
		rotation: 180

		behavior Image
		{
			assetPath: $"ui_image/rui/borders/border_jclb_mask.rpak"
			assetMaskPath: $"ui_image/rui/menu/lobby/jclb_dots.rpak"
			alpha: 0.3
		}
	}

	panel TopLeftDecoration
	{
		anchor: TOP_LEFT
		pivot: <0, 0>
		size: <46, 46>

		behavior Image
		{
			assetPath: $"ui_image/rui/borders/border_jclb_tl.rpak"
		}
	}

	panel BottomRightDecoration
	{
		anchor: BOTTOM_RIGHT
		pivot: <1, 1>
		size: <144, 113>

		behavior Image
		{
			assetPath: $"ui_image/rui/borders/border_jclb_br.rpak"
		}
	}

	panel Content
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		// Override this!
	}
}