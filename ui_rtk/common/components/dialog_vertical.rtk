panel DialogVertical
{
	anchor: CENTER_STRETCH_HEIGHT
	offsets: <0, 0, 0, 0>
	width: 625

	behavior Image
    {
		color: #212324
    }

    panel Dots
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		behavior Image
	    {
	        assetPath: $"ui_image/rui/menu/requeue/requeue_modal_bg.rpak"
	    }
	}

    panel StackedContent
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior VerticalContainer
		{
			spacing: 0
			alignment: TOP
		}

		panel TopSpacer
		{
			anchor: CENTER_STRETCH_WIDTH
			offsets: <0, 0, 0, 0>
			height: 112
		}

		panel TitleSizer
		{
			anchor: CENTER_STRETCH_WIDTH
			offsets: <0, 0, 0, 0>
			height: 200

			behavior Image
		    {
	            assetPath: $"ui_image/rui/menu/requeue/requeue_modal_header_chevron_bg.rpak"
		    }

			panel TopLine
			{
				anchor: TOP_STRETCH_WIDTH
				offsets: <0, 0, 0, 0>
				height: 10

				panel TopLineRight
				{
					anchor: TOP_RIGHT
					size: <372, 10>
					pivot: <1.0, 0.0>
					positionX: 5

					behavior Image
				    {
			           assetPath: $"ui_image/rui/menu/requeue/requeue_modal_header_divider.rpak"
			           color: #959595
				    }
				}

				panel BackplateLine
				{
					anchor: TOP_STRETCH_WIDTH
					offsets: <0, 0, 0, 0>
					height: 4

					behavior Image
				    {
			           color: #959595
				    }
				}

			    panel TopLineLeft
				{
					anchor: TOP_LEFT
					size: <270, 7>
					pivot: <0.0, 0.0>
					offsets: <0, 0, 0, 0>
					positionY: 1

					behavior Image
				    {
			           color: #959595
				    }
				}
			}

			panel BottomLine
			{
				anchor: BOTTOM_STRETCH_WIDTH
				offsets: <0, 0, 0, 0>
				height: 3

				behavior Image
			    {
		           color: #959595
			    }
			}

			panel TitleContext
			{
				anchor: CENTER_STRETCH_WIDTH
				offsets: <0, 0, 0, 0>
			}
		}

		panel ContentContext
		{
			anchor: CENTER_STRETCH_WIDTH
			offsets: <0, 0, 0, 0>
		}
	}

	panel FooterContext
	{
		anchor: BOTTOM_STRETCH_WIDTH
		positionY: -20
		offsets: <0, 0, 0, 0>

	}
}