panel TimerComponentLong
{
	var iconPath @this/TimerIcon:FormatLabel.format
	var iconColor @this/TimerIcon:FormatLabel.colorRGB
	var iconHeight @this/TimerIcon:FormatLabel.pixelHeight
	var fontColor @this/TimerString:FormatLabel.colorRGB
	var fontHeight @this/TimerString:FormatLabel.pixelHeight
	var additionalFormat @this/TimerString:FormatLabel.format
	var allCaps @this/TimerString:FormatLabel.allCaps
	var fitContentHeight @this:HorizontalContainer.fitContentHeight

	var Container @root:HorizontalContainer
	var IconLabel @root/TimerIcon:FormatLabel
	var TimerLabel @root/TimerString:FormatLabel

	anchor: CENTER
	height: 50

	behavior HorizontalContainer
	{
		alignment: CENTER
		fitContentWidth: true
		useLocaleDirection: true
	}

	behavior Timer

	panel TimerIcon
	{
		anchor: CENTER

		behavior FormatLabel
		{
			bind @this.format -> LocalizeString -> @this.arg1

			format: "%$rui/menu/store/feature_timer% "
			textAlignHorizontal:  CENTER
			textAlignVertical: CENTER
			horizontalMode: AUTOSIZE_TO_TEXT
			verticalMode: AUTOSIZE_TO_TEXT
			pixelHeight: 30
			face: "DefaultRegularFont"
			colorRGB: <0.8, 0.64, 0.2>

			arg1: ""
		}
	}

	panel TimerString
	{
	    anchor: CENTER
		behavior FormatLabel
		{
			bind @panel.parent:Timer.remainingTime -> FormatTimeLong -> @this.arg1

            format: "#TIME_REMAINING"
			textAlignHorizontal:  LEFT
			textAlignVertical: CENTER
			horizontalMode: AUTOSIZE_TO_TEXT
			verticalMode: AUTOSIZE_TO_TEXT
			pixelHeight: 30
			face: "DefaultRegularFont"
			colorRGB: <0.8, 0.64, 0.2>
			allcaps: true
		}
	}

}