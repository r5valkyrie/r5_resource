panel ResultsBreakdownBodyPanel
{
	anchor: CENTER_STRETCH_WIDTH_HEIGHT
	offsets: <0, 0, 0, 0>

	behavior Image Border
	{
		assetPath: $"ui_image/rui/borders/ready_frame_border_2px.rpak"
		color: <0.5, 0.5, 0.5, 1.0>
	}

	panel TranslucentBG
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			assetPath: $"ui_image/rui/borders/ready_frame_border.rpak"
			color: <0.2, 0.2, 0.2, 0.5>
		}
	}
}