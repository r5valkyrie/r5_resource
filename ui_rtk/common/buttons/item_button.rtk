panel ItemButton
{
	bind root

	bind *.name -> @this/Content/Text:Label.text
	bind *.quality -> QualityTextColor -> @this/Content/Text:Label.colorRGB
	bind *.eventIcon -> @this/Content/IconEvent:Image.assetPath
	bind *.locked -> PickFloatFromTwo( 0.8, 0.4 ) -> @this/Content/Text:Label.alpha
	bind *.locked -> PickFloatFromTwo( 0.8, 0.4 ) -> @this/Background:Image.alpha
	bind *.locked -> @this/Content/IconLocked.visible
	bind *.equipped -> @this/Content/IconEquipped.visible
	bind *.selected -> PickVectorFromTwo( #666666, #FFFFFF ) -> @this/Outline:Image.colorRGB

	anchor: CENTER
	size: <350, 50>
	inputListener: true

	behavior Button
	{
		soundHighlighted: "UI_Menu_Focus_Small"
		rightMouseEnabled: true
		middleMouseEnabled: true
		transitions: [
		{
			fromState: ANY
			toState: IDLE
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/Hover.visible
			value: false
		},
		{
			fromState: ANY
			toState: HIGHLIGHTED
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/Hover.visible
			value: true
		}
		]
	}

	panel Background
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: #000000
			alpha: 0.6
			assetPath: $"ui_image/rui/menu/buttons/generic_item/button_bg.rpak"
		}
	}

	panel Content
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <5, 5, 5, 5>

		behavior HorizontalContainer
		{
			fitContentHeight: true
			alignment: LEFT
			spacing: 5
			useLocaleDirection: true
		}

		panel Text
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <20, 50, 0, 0>

			behavior Label
			{
				face: "TitleRegularFont"
				text: ""
				textAlignHorizontal: LEFT
				textAlignVertical: CENTER
				horizontalMode: SQUISH_TO_CONTAINER
				pixelHeight: 24
				color: <1, 1, 1, 1>
				allCaps: false
				margin: <10, 0, 0, 0>
				useLocaleDirection: true
			}
		}

		panel IconEvent
		{
			anchor: CENTER
			size: <26, 26>

			behavior Image
			{
				assetPath: $""
				colorRGB: <1, 1, 1>
			}
		}

		panel IconLocked
		{
			anchor: CENTER
			size: <26, 26>
			visible: false

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/buttons/lock.rpak"
				alpha: 1
				colorRGB: <0.56, 0.56, 0.56>
			}
		}

		panel IconEquipped
		{
			anchor: CENTER
			size: <26, 26>
			visible: false

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/buttons/equipped.rpak"
				alpha: 1
				colorRGB: <1, 0.541, 0>
			}
		}
	}

	panel Outline
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: #FFFFFF
			assetPath: $"ui_image/rui/menu/buttons/generic_item/button_border.rpak"
		}
	}

	panel Hover
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>
		visible: false

		behavior Image
		{
			colorRGB: #FFFFFF
			assetPath: $"ui_image/rui/menu/buttons/generic_item/button_focus.rpak"
		}


		behavior Animator
		{
			tweenAnimations: [
			{
				name: "focusLoop"
				loop: PINGPONG
				tweens: [
				{
					property: @owner.panel:Image.alpha
					startValue: 0.3
					endValue: 0.6
					duration: 0.5
				}
				]
			}
			]
		}

		behavior AnimatorAutoPlay
		{
			animation: "focusLoop"
		}
	}
}