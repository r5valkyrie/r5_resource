instance $"ui_rtk/common/buttons/loot_button.rpak" ApexPacksOpenButton
{
	inputListener: true

	size: <660, 200>

	var availablePacksVisible @this/TopRightCorner.visible
	var availablePacksText @this/TopRightCorner/AvailablePacksText:Label.text

	override @var(size) <660, 200>

	override @var(labelVisible) false

	override @var(packContentVisible) true
	override @var(backgroundSaturation) 1.0
	override @var(backgroundLightness) 0
	override @var(backgroundAlpha) 1.0
	override @var(backgroundColor) #202020

	override @var(icon) $"ui_image/rui/borders/gifting_loot_tick.rpak"
	override @var(iconSize) <160, 160>
	override @var(iconPosition) <-180, 0>

	override @var(iconContainerSize) <-160, 160>

	override @var(packTitlePixelHeight) 47
	override @var(packTitleHorizontalMode) OVERFLOW

	override @var(packDescriptionFontName) "TitleRegularFont"
	override @var(packDescriptionPixelHeight) 47
	override @var(packDescriptionHorizontalMode) OVERFLOW

	override @var(packCountPixelHeight) 100
	override @var(packCountTextSize) <100, 100>
	override @var(packCountTextColor) #FF4E1D
	override @var(packCountTextMargin) <0, 30, 0, 0>
	override @var(packCountHorizontalMode) SQUISH_TO_CONTAINER

	panel TopRightCorner
	{
		anchor: TOP_RIGHT
		pivot: <1, 0>
		position: <-3, 3>
		size: <334, 40>

		behavior Image
		{
			assetPath: $"ui_image/rui/menu/buttons/open_pack_btn_total_count_tab.rpak"
		}

		panel AvailablePacksText
		{
			anchor: RIGHT
			pivot: <1, 0.5>
			position: <-10, 0>

			behavior Label
			{
				face: "TitleBoldFont"
				textAlignHorizontal: RIGHT
				textAlignVertical: CENTER
				horizontalMode: AUTOSIZE_TO_TEXT
				verticalMode: AUTOSIZE_TO_TEXT
				color: <1, 1, 1, 1>
				pixelHeight: 40
			}
		}
	}
}
