panel BaseButton
{
	// base settings
	var size @this.size
	var pivot @this.pivot
	var labelText @this/Text/TitleText:Label.text
	var labelFont @this/Text/TitleText:Label.face
	var labelOffsets @this/Text.offsets
	var labelPixelHeight @this/Text/TitleText:Label.pixelHeight
	var labelHorizontalMode @this/Text/TitleText:Label.horizontalMode
	var lineHeight @this/Line.height
	var labelDescText @this/Text/DescText:Label.text
	var labelDescFont @this/Text/DescText:Label.face
	var labelDescPixelHeight @this/Text/DescText:Label.pixelHeight

	// visibility
	var backgroundAlpha @this/BackgroundFill:Image.alpha
	var gradientAlpha @this/BackgroundGradient:Image.alpha
	var lineAlpha @this/Line:Image.alpha

	// idle colors settings
	var labelColor @this/Text/TitleText:Label.colorRGB
	var backgroundColor @this/BackgroundFill:Image.colorRGB
	var outlineColor @this/Outline:Image.colorRGB
	var gradientColor @this/BackgroundGradient:Image.colorRGB
	var innerGlowColor @this/InnerGlow:Image.colorRGB
	var lineColor @this/Line:Image.colorRGB

	// hover settings
	var gradientHoverColor @this/BackgroundGradientHover:Image.colorRGB
	var outlineHoverColor @this/OutlineHover:Image.colorRGB

	anchor: CENTER
	size: <340, 104>
	inputListener: true

	behavior Button
	{
		soundHighlighted: "ui_menu_focus"
		soundPressedEnabled: "ui_menu_accept"
		transitions: [
			// Inner Glow
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_TWEEN
				animName: "onIdle"
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_TWEEN
				animName: "onHighlighted"
			},
			{
				fromState: HIGHLIGHTED
				toState: PRESSED
				type: TRANSITION_TWEEN
				animName: "onHighlightedToPressed"
			},
			{
				fromState: PRESSED
				toState: HIGHLIGHTED
				type: TRANSITION_TWEEN
				animName: "onPressedToHighlighted"
			},

			// Outline Hide/Show
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Outline:Image.alpha
				value: 1.0
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Outline:Image.alpha
				value: 0.0
			},
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/OutlineHover:Image.alpha
				value: 0.0
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/OutlineHover:Image.alpha
				value: 1.0
			},
			{
				fromState: ANY
				toState: NON_INTERACTIVE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/OutlineHover:Image.alpha
				value: 0.0
			},

			//Line Color
			{
				fromState: ANY
				toState: NON_INTERACTIVE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Line:Image.colorRGB
				value: #7d7e7f
			},
			{
				fromState: NON_INTERACTIVE
				toState: ANY
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/Line:Image.colorRGB
				value: #FF4E1D
			},

			// Background Gradient
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradient:Image.alpha
				value: 0.2
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradient:Image.alpha
				value: 0.0
			},
			{
				fromState: ANY
				toState: NON_INTERACTIVE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradient:Image.colorRGB
				value: #7d7e7f
			},
			{
				fromState: NON_INTERACTIVE
				toState: ANY
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradient:Image.colorRGB
				value: #FF4E1D
			},
			{
				fromState: ANY
				toState: IDLE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradientHover:Image.alpha
				value: 0.0
			},
			{
				fromState: ANY
				toState: NON_INTERACTIVE
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradientHover:Image.alpha
				value: 0.0
			},
			{
				fromState: ANY
				toState: HIGHLIGHTED
				type: TRANSITION_PROPERTY_SET
				property: @owner.panel/BackgroundGradientHover:Image.alpha
				value: 0.2
			}
		]
	}

	behavior Animator
	{
		tweenAnimations: [
			{
				name: "onIdle"
				tweens: [
					{
						property: @owner.panel/InnerGlow:Image.alpha
						startValue: 0.2
						endValue: 0.0
						duration: 0.15
					}
				]
			},
			{
				name: "onHighlighted"
				tweens: [
					{
						property: @owner.panel/InnerGlow:Image.alpha
						startValue: 0.0
						endValue: 0.2
						duration: 0.15
					}
				]
			},
			{
				name: "onHighlightedToPressed"
				tweens: [
					{
						property: @owner.panel/InnerGlow:Image.alpha
						startValue: 0.2
						endValue: 0.2
						duration: 0.15
					}
				]
			},
			{
				name: "onPressedToHighlighted"
				tweens: [
					{
						property: @owner.panel/InnerGlow:Image.alpha
						startValue: 0.2
						endValue: 0.2
						duration: 0.15
					}
				]
			}
		]
	}

	panel BackgroundFill
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: <0.2, 0.2, 0.2>
		}
	}

	panel BackgroundGradient
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: #FF4E1D
			alpha: 0.2
			assetPath: $"ui_image/rui/gradient_ud_compressed.rpak"
		}
	}

	panel BackgroundGradientHover
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: #FF4E1D
			assetPath: $"ui_image/rui/gradient_ud_compressed.rpak"
		}
	}

	panel Text
	{
		anchor: CENTER_STRETCH_WIDTH
		offsets: <10, 10, 10, 10>

		behavior VerticalContainer
		{
			alignment: CENTER
			fitContentHeight: true
		}

		panel TitleText
		{
			bind @root.width -> Add( -20 ) -> @this.width
			bind @this:Label.text -> IsEmpty -> NOT -> @this.visible
			behavior Label
			{
				face: "TitleBoldFont"
				text: ""
				textAlignHorizontal: CENTER
				textAlignVertical: CENTER
				horizontalMode: WRAP
				verticalMode: AUTOSIZE_TO_TEXT
				pixelHeight: 24
				color: <1, 1, 1, 1>
				allCaps: true
			}

			behavior LabelAltStyle
			{
				face: "TitleBoldFont"
				pixelHeight: 24
				color: <1, 1, 1, 1>
			}

			behavior LabelAltStyle
			{
				face: "TitleBoldFont"
				pixelHeight: 24
				color: <1, 1, 1, 1>
			}
		}

		panel DescText
		{
			bind @root.width -> Add( -20 ) -> @this.width
			bind @this:Label.text -> IsEmpty -> NOT -> @this.visible
			behavior Label
			{
				face: "TitleFont"
				text: ""
				textAlignHorizontal: CENTER
				textAlignVertical: CENTER
				horizontalMode: WRAP
				verticalMode: AUTOSIZE_TO_TEXT
				pixelHeight: 24
				color: <1, 1, 1, 1>
			}

			behavior LabelAltStyle
			{
				face: "TitleFont"
				color: <1, 1, 1, 1>
			}
		}
	}

	panel InnerGlow
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: #FF4E1D
			alpha: 0
			assetPath: $"ui_image/rui/borders/border_inner_glow.rpak"
		}
	}

	panel Outline
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <-0.5, -0.5, 0, 0>

		behavior Image
		{
			colorRGB: <0.7, 0.7, 0.7>
			assetPath: $"ui_image/rui/borders/border_outline_2px.rpak"
		}
	}

	panel OutlineHover
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <-1, -1, 0, 0>

		behavior Image
		{
			colorRGB: #FF4E1D
			assetPath: $"ui_image/rui/borders/border_outline_4px.rpak"
		}
	}

	panel Line
	{
		anchor: BOTTOM_STRETCH_WIDTH
		offsets: <0, 0, 0, 0>
		pivot: <0.5, 1>
		height: 10

		behavior Image
		{
			colorRGB: #FF4E1D
		}
	}
}
