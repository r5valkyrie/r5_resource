panel ProgressBar
{
	anchor: CENTER
	size: <500, 100>

	var value               @this:ProgressBar.value
	var min                 @this:ProgressBar.min
	var max                 @this:ProgressBar.max
	var useLocaleDirection  @this:ProgressBar.useLocaleDirection
	var bgVisible           @this/Background.visible
	var bgAlpha             @this/Background:Image.alpha
	var bgBlur              @this/Background:Image.imageBlur
	var bgColor             @this/Background:Image.colorRGB
	var bgAssetPath         @this/Background:Image.assetPath
	var bgMaskAssetPath     @this/Background:Image.assetMaskPath
	var barAlpha            @this/Bar:Image.alpha
	var barColor            @this/Bar:Image.colorRGB
	var barAssetPath        @this/Bar:Image.assetPath
	var barMaskAssetPath    @this/Bar:Image.assetMaskPath

	behavior ProgressBar
	{
		bar: @panel/Bar
		barContainer: @panel
		useLocaleDirection: true
	}

	panel Background
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		pivot: <0, 0.5>
		position: <0, 0>
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: <0.5, 0.5, 0.5>
			flipHorizontal: false
			flipVertical: true
			assetPath: $"ui_image/white.rpak"
			assetMaskPath: $""
		}
	}

	panel Bar
	{
		anchor: LEFT_STRETCH_HEIGHT
		pivot: <0, 0.5>
		position: <0, 0>
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: <1, 1, 1>
			alpha: 1.0
			flipHorizontal: false
			flipVertical: true
			assetPath: $"ui_image/white.rpak"
			assetMaskPath: $""
		}
	}
}
