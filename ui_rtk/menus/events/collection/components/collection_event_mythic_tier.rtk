panel CollectionEventMythicTier // Not re-usable, just for list binder
{
	bind root
	anchor: TOP_LEFT
	inputListener: true

	behavior HorizontalContainer
	{
		spacing: 0
		fitContentHeight: true
		fitContentWidth: true
		alignment: CENTER
	}

	behavior Button
	{
		soundHighlighted: "UI_Menu_Focus_Small"
		rightMouseEnabled: true
		middleMouseEnabled: true
		transitions: [
		{
			fromState: ANY
			toState: IDLE
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/ItemSingle/Outline:Image.colorRGB
			value: <1.0, 0.258, 0>
		},
		{
			fromState: ANY
			toState: HIGHLIGHTED
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/ItemSingle/Outline:Image.colorRGB
			value: <1.0, 0.558, 0.1>
		}
		]
	}

	panel ItemSingle
	{
		anchor: CENTER
		size: <80, 80>
		inputListener: true

		behavior ToolTip
		{
			bind *.tooltipTitle -> @this.varOverrides.titleText

			prefab: $"ui_rtk/common/tooltips/base_tooltip.rpak"
			offset: <32, -68>
			delay: 0

			varOverrides: {
				titleText: ""
				actionText: "#COLLECTION_EVENT_DETAILS_MYTHIC_ACTION"
				isIconVisible: false
				isAdditionalTextVisible: false
				isBodyVisible: false
				isActionTextVisible: true
			}
		}

		panel Background
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <0, 0, 0, 0>

			behavior Image
			{
				colorRGB: #555555
				alpha: 1
			}
		}

		panel Dots
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <0, 0, 0, 0>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/melee_customization/melee_customization_grid_dots.rpak"
				colorRGB: #575757
			}
		}

		panel Icon
		{
			bind *.imageSize -> @this.height
			bind *.imageSize -> @this.width

			anchor: CENTER
			size: <80, 80>

			behavior Image
			{
				bind *.image -> @this.assetPath
			}
		}

		panel Pips
		{
			anchor: BOTTOM
			pivot: <0.5, 1>
			position: <0, -8>

			behavior HorizontalContainer
			{
				spacing: 10
				fitContentHeight: true
				fitContentWidth: true
				alignment: CENTER
			}

			behavior ListBinder ListBinder
			{
				bindingPath: "*.pips"
				prefab: $"ui_rtk/menus/events/collection/components/collection_event_mythic_tier_pip.rpak"
			}

		}

		panel Outline
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			offsets: <-1, -1, -1, -1>

			behavior Image
			{
				assetPath: $"ui_image/rui/borders/border_outline_2px.rpak"
				colorRGB: <1.0, 0.258, 0>
			}
		}

		panel Check
		{
			bind *.locked -> NOT -> @this.visible

			anchor: TOP_RIGHT
			pivot: <1, 0>
			size: <24, 24>
			position: <-7, 4>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/buttons/checked.rpak"
				colorRGB: #EF8105
			}
		}

		panel Lock
		{
			bind *.locked -> @this.visible

			anchor: TOP_RIGHT
			pivot: <1, 0>
			size: <22, 22>
			position: <-4, 5>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/buttons/lock.rpak"
			}
		}
	}

	panel ArrowBG
	{
		bind *.showArrow -> @this.visible

		anchor: RIGHT
		pivot: <0, 0>
		size: <20, 26>
		position: <0, 0>

		panel ArrowBG
		{
			anchor: LEFT
			pivot: <0, 0.5>
			size: <26, 26>
			position: <-2, 0>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/heirloom_crafting/heirloom_page_arrow_bg.rpak"
				colorRGB: <1, 1, 1>
			}
		}

		panel Arrow
		{
			anchor: LEFT
			pivot: <0, 0.5>
			size: <42, 28>
			position: <-10, 0>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/heirloom_crafting/heirloom_page_arrow.rpak"
				colorRGB: <1, 1, 1>
			}
		}
	}

	panel Link
	{
		bind *.showLink -> @this.visible

		anchor: LEFT
		pivot: <0.5, 0.5>
		size: <40, 26>
		positionX: -3

		panel LinkBG
		{
			anchor: CENTER_STRETCH_WIDTH_HEIGHT

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/heirloom_crafting/heirloom_page_link_bg.rpak"
				colorRGB: <1, 1, 1>
			}
		}

		panel Link
		{
			anchor: CENTER
			pivot: <0.5, 0.5>
			size: <20, 12>

			behavior Image
			{
				assetPath: $"ui_image/rui/menu/heirloom_crafting/heirloom_page_link.rpak"
				colorRGB: <1, 1, 1>
			}
		}

		behavior ContainerElement
		{
			ignoreLayout: true
		}
	}
}