panel CollectionEventCollectionItem // Not re-usable, just for list binder
{
	bind root

	bind *.visible -> @this.visible

	var size @this.size
	var tooltipTitleText @this/Tooltip.varOverrides.titleText
	var tooltipSubTitleText @this/Tooltip.varOverrides.subtitleText
	var tooltipSubTitleColor @this/Tooltip.varOverrides.subtitleColor
	var backgroundFillAlpha @this/BackgroundFill:Image.alpha
	var backgroundGradientAlpha @this/BackgroundGradient:Image.alpha
	var backgroundGradientColor @this/BackgroundGradient:Image.colorRGB
	var backgroundDotsAlpha @this/BackgroundDots:Image.alpha
	var backgroundDotsColor @this/BackgroundDots:Image.colorRGB
	var iconAlpha @this/AssetIcon:Image.assetPath
	var iconAssetPath @this/AssetIcon:Image.alpha
	var backgroundOutlineAlpha @this/BackgroundOutline:Image.alpha
	var backgroundOutlineColor @this/BackgroundOutline:Image.colorRGB
	var ownedFlagVisible @this/OwnedFlag.visible

	anchor: TOP_LEFT
	size: <75, 75>
	inputListener: true

	behavior Button
	{
		soundHighlighted: "ui_menu_focus"
		soundPressedEnabled: "ui_menu_accept"
		transitions: [
		{
			fromState: ANY
			toState: IDLE
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/HighlightOutline:Image.alpha
			value: 0.0
		},
		{
			fromState: ANY
			toState: HIGHLIGHTED
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/HighlightOutline:Image.alpha
			value: 1.0
		},
		{
			fromState: ANY
			toState: IDLE
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/InnerGlow:Image.alpha
			value: 0
		},
		{
			fromState: ANY
			toState: HIGHLIGHTED
			type: TRANSITION_PROPERTY_SET
			property: @owner.panel/InnerGlow:Image.alpha
			value: 0.07
		}
		]

	}

	behavior ToolTip Tooltip
	{
		bind *.tooltipInfo.titleText -> @this.varOverrides.titleText
		bind *.quality -> QualityName -> @this.varOverrides.subtitleText
		bind *.quality -> QualityTextColor -> @this.varOverrides.subtitleColor

		prefab: $"ui_rtk/common/tooltips/base_tooltip.rpak"
		offset: <32, -68>
		delay: 0

		varOverrides: {
			// defaults
			titleText: ""
			subtitleText: ""
			bodyText: ""
			additionalText: ""
			icon: $""
			isIconVisible: false
			isAdditionalTextVisible: false
			titleColor: #ffffff
			subtitleColor: #ffffff
			additionalTextAltColor: #ffffff
			iconColor: #ffffff

			// overrides
			actionText: "#A_BUTTON_INSPECT"
			isSubtitleVisible: true
		}
	}

	panel BackgroundFill
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			bind *.state -> AlphaFromShopItemState( 0.8, 1.0 ) -> @this.alpha
			color: #Black
			assetPath: $"ui_image/rui/menu/events/event_shop/notched_bg.rpak"
		}
	}

	panel BackgroundGradient
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			bind *.quality -> Add(1) -> QualityColor( *.isOwned ) -> @this.colorRGB
			bind *.state -> AlphaFromShopItemState( 0.1, 0.2 ) -> @this.alpha

			color: <1.0, 1.0, 1.0, 0.2>
			assetPath: $"ui_image/rui/menu/events/event_shop/shop_item_gradient.rpak"
		}
	}

	panel BackgroundDots
	{
		anchor: TOP_LEFT
		pivot: <0, 0>
		size: <80, 80>
		position: <5, 5>
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			bind *.quality -> Add(1) -> QualityColor( *.isOwned ) -> @this.colorRGB
			bind *.state -> AlphaFromShopItemState( 0.3, 1.0 ) -> @this.alpha

			color: <1, 1, 1, 1>
			assetPath: $"ui_image/rui/menu/events/event_shop/shop_item_dots.rpak"
		}
	}

	panel AssetIcon
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		pivot: <0.5, 0>
		offsets: <5, 5, 5, 5>

		behavior Image
		{
			bind *.icon -> @this.assetPath
			bind *.state -> AlphaFromShopItemState( 0.2, 1.0 ) -> @this.alpha
		}
	}

	panel InnerGlow
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			colorRGB: <1, 0.3, 0.1>
			alpha: 0
			assetPath: $"ui_image/rui/inner_glow.rpak"
		}
	}

	panel BackgroundOutline
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <0, 0, 0, 0>

		behavior Image
		{
			bind *.quality -> Add(1) -> QualityColor( *.isOwned ) -> @this.colorRGB
			bind *.state -> AlphaFromShopItemState( 0.2, 1.0 ) -> @this.alpha

			color: <1, 1, 1, 1>
			assetPath: $"ui_image/rui/menu/events/event_shop/notched_border_2px.rpak"
		}
	}

	panel HighlightOutline
	{
		anchor: CENTER_STRETCH_WIDTH_HEIGHT
		offsets: <-0.3, -0.3, -0.3, -0.3>

		behavior Image
		{
			color: <1, 0.3, 0.1, 0>
			assetPath: $"ui_image/rui/menu/events/event_shop/notched_border_4px.rpak"
		}
	}

	panel OwnedFlag
	{
		bind *.isOwned -> @this.visible

		anchor: TOP_RIGHT
		pivot: <1, 0>
		size: <40, 40>
		position: <-0.5, 0.3>

		behavior Image
		{
			color: <1, 1, 1, 1>
			assetPath: $"ui_image/rui/menu/events/event_shop/shop_item_owned.rpak"
		}
	}
}