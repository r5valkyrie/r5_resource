panel CrossProgressionIsHere
{
	bind root

	anchor: CENTER_STRETCH_WIDTH_HEIGHT
	offsets: <0, 0, 0, 0>

	panel Content
	{
		anchor: CENTER_STRETCH_WIDTH
		offsetsLR: <98, 98>
		positionY: 56

		behavior VerticalContainer
		{
			padding: <98, 98, 0, 0>
			alignment: CENTER
			fitContentHeight: true
			fitContentWidth: true
		}

		panel BodyText
		{
			anchor: TOP
			pivot: <0.5, 0>
			size: <1000, 260>

			behavior Label
			{
				face: "TitleRegularFont"
				pixelHeight: 32
				colorRGB: #ffffff
				textAlignHorizontal: CENTER
				textAlignVertical: CENTER
				horizontalMode: WRAP
				text: "#CROSS_PROGRESSION_ROLLOUT_DESC"
				alpha: 0.5
				leading: 5
			}
		}

		instance $"ui_rtk/common/buttons/base_button.rpak" ContinueButton
		{
			override @var(labelText) "#A_BUTTON_CONTINUE"
			override @var(lineAlpha) 0
			override @var(size) <300, 64>
			override @var(labelPixelHeight) 24
			override @var(backgroundColor) #242526
			override @var(outlineColor) #b4b4b5
			override @var(gradientColor) #78797a
		}
	}
}