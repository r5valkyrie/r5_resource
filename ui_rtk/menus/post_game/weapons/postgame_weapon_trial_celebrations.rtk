	panel TrialsList
	{
		anchor: CENTER
		pivot: <0.0, 0.0>
		position: <-230, -129>

		behavior HorizontalContainer
		{
			fitContentWidth: true
			fitContentHeight: true
			spacing: 40
		}

		behavior ListBinder
		{
			bindingPath: "*.trials"
			prefab: $"ui_rtk/menus/post_game/weapons/components/postgame_animated_weapon_mastery_trial_card.rpak"
		}

		behavior TweenStagger
		{
			active: false
			startDelay: 1.35
			delay: -0.2
			animationName: "EnterScene"
			initTweensOnEnable: true
			useMaxTweenTime: true
		}
	}

	panel TrialIconList
	{
		anchor: CENTER
		pivot: <0.5, 0.5>
		position: <0, 100>

		behavior HorizontalContainer
		{
			fitContentWidth: true
			fitContentHeight: true
			spacing: 62
		}

		behavior ListBinder
		{
			bindingPath: "*.trials"
			prefab: $"ui_rtk/menus/mastery/components/mastery_trial_icon_invisible.rpak"
			rangeStart: 0
			rangeEnd : 4
		}

		behavior TweenStagger
		{
			active: false
			delay: -0.12
			animationName: "FadeIn"
			initTweensOnEnable: true
			useMaxTweenTime: true
		}
	}

	panel ChevronWoosh
	{
		anchor: CENTER
		pivot: <0.5, 0.5>
		position: <0, 100>
		size: <240, 210>

		behavior Image
		{
			assetPath: $"ui_image/rui/menu/mastery/weaponmastery_completion_chevron_blur.rpak"
			flipHorizontal: true
			color: <1.0, 1.0, 1.0, 0.0>
		}
	}

	panel CelebrationRui
	{
		anchor: CENTER
		pivot: <0.5, 0.5>
		size: <1920, 1080>

		behavior Rui
		{
			//bind *.weapon.ruiArgs -> @this.args // TODO: Make a jira to get this functionality added.
			bind *.weapon.ruiArgs.weaponIcon -> @this.args.weaponIcon
			bind *.weapon.ruiArgs.weaponName -> @this.args.weaponName
			bind *.weapon.ruiArgs.weaponLevel -> @this.args.weaponLevel
			bind *.weapon.ruiArgs.startTime -> @this.args.startTime

			ruiAsset: $"ui/mastery_weapon_celebration.rpak"
			args: {
				weaponIcon: $""
				weaponName: ""
				weaponLevel: ""
				startTime: 0.0
			}
		}
	}

	panel Title
	{
		anchor: CENTER
        pivot: <0.5, 0.5>
        position: <0, -473>

		behavior Label
		{
			text: "#MASTERY_WEAPON_TRIALS_TITLE"
			face: "TitleBoldFont"
			pixelHeight: 70
			textAlignHorizontal: CENTER
			textAlignVertical: CENTER
			horizontalMode: AUTOSIZE_TO_TEXT
			verticalMode: AUTOSIZE_TO_TEXT
			allCaps: true
			colorRGB: <1, 1, 1> // TODO: Bug #White resulting in 0.67, 0.70, 0.75
		}
    }

    instance $"ui_rtk/menus/post_game/weapons/components/postgame_weapons_trials_complete_header.rpak" TrialsCompleteHeader
	{
		anchor: CENTER
		position: <0, 0>

		override bind root "*"
	}

	panel UltimateTrial
	{
		anchor: CENTER
		pivot: <0.5, 0.5>
		position: <0, 150>

		behavior ListBinder
		{
			bindingPath: "*.allWeaponsTrials"
			prefab: $"ui_rtk/menus/post_game/weapons/components/postgame_animated_weapon_mastery_all_trial_card.rpak"
		}
	}

    instance $"ui_rtk/controls/footer.rpak"
}