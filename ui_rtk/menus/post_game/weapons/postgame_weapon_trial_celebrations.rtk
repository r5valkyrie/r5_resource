panel WeaponTrialCelebrationsScreen
{
	bind root

	anchor: CENTER
	size: <1920, 1080>

	behavior PostGameWeaponTrialCelebrations
	{
		animator: @panel:Animator
		trialsList: @panel/TrialsList
		trialsTweenStagger: @panel/TrialsList:TweenStagger
		trialIconList: @panel/TrialIconList
		trialsCompleteHeader: @panel/TrialsCompleteHeader
		celebrationWeaponIcons: @panel/TrialsCompleteHeader/WeaponIcons
		ultimateTrialsList: @panel/UltimateTrial
	}

	behavior Animator
	{
		keyframeAnimations: [
			{
				name: "EnterScene"
				animAsset: $"ui_rtk/menus/post_game/weapons/animations/animation_trial_update_present.rpak"
			},
			{
				name: "ChevronBlurWoosh"
				animAsset: $"ui_rtk/menus/post_game/weapons/animations/animation_chevron_blur_woosh.rpak"
			}
		]

		tweenAnimations: [
			{
				name: "CenterTrial"
				tweens: [
					{
						property: @panel/TrialsList.positionX
						startValue: 0
						endValue: 500
						duration: 0.3337
						curve: EASE_OUT_CUBIC
					}
				]
			},
			{
				name: "PrepForUltimateTrial" // clear the screen to prep for celebration animation
				tweens: [
					{
						property: @panel/TrialsList.positionY
						startValue: -119
						endValue: 961
						duration: 1
						curve: EASE_OUT_CUBIC
					},
					{
						property: @panel/CelebrationRui.positionY
						startValue: 0
						endValue: -1080
						duration: 1
						curve: EASE_OUT_CUBIC
					},
					{
						property: @panel/Title.positionY
						startValue: -473
						endValue: -1553
						duration: 1
						curve: EASE_OUT_CUBIC
					}
				]
			}
		]
	}

