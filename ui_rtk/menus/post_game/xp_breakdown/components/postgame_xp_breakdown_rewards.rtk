panel NextLevelRewards
{
	bind root

	behavior VerticalContainer
	{
		fitContentWidth: true
		fitContentHeight: true
		spacing: 10
	}

	panel Container
	{
		offsets: <0, 0, 0, 0>

		behavior HorizontalContainer
		{
			fitContentWidth: true
			fitContentHeight: true
			spacing: 10
		}

		behavior ListBinder
		{
			bindingPath: "*"
			prefab: $"ui_rtk/menus/post_game/xp_breakdown/components/postgame_xp_breakdown_reward_icon.rpak"
		}
	}

	panel NextRewardLabel
	{
		bind @this/Text:Label.pixelHeight -> @this.height
		bind @parent/Container.width -> @this.width
		bind * -> GetArrayCount -> GreaterThan(1) -> PickStringFromTwo("#EOG_NEXT_REWARD_LABEL", "#EOG_NEXT_REWARDS_LABEL") -> @this/Text:Label.text

		anchor: BOTTOM_STRETCH_WIDTH
		size: <0, 38>
		pivot: <0.5, 0.0>
		position: <0, 0>
		offsets: <0, 0, 0, 0>

		panel HeaderLeft
		{
			size: <0, 3>
			position: <300, 10>

			behavior Image

			behavior ContainerElement
			{
				horizontalAlignOverride: LEFT
				verticalAlignOverride: CENTER
			}

			panel HeaderLeftTop
			{
				bind * -> GetArrayCount -> GreaterThan(1) -> @this.visible
				size: <3, 12>
				pivot: <0, 1>
				anchor: LEFT
				behavior Image
			}
		}

		panel Text
		{
			size: <430, 38>
			behavior Label
			{
				text: "Default Text"
				face: "TitleBoldFont"
				pixelHeight: 21
				textAlignHorizontal: CENTER
				textAlignVertical: TOP
				allcaps: true

				horizontalMode: AUTOSIZE_TO_TEXT
				verticalMode: CLIP
			}

			behavior ContainerElement
			{
				autosizeToLabelWidth: true
			}
		}

		panel HeaderRight
		{
			size: <0, 3>
			position: <0, 10>

			behavior Image
			behavior ContainerElement
			{
				horizontalAlignOverride: RIGHT
				verticalAlignOverride: CENTER
			}

			panel HeaderRightTop
			{
				bind * -> GetArrayCount -> GreaterThan(1) -> @this.visible
				size: <3, 12>
				pivot: <1, 1>
				anchor: RIGHT
				behavior Image
			}
		}

		behavior HorizontalContainer
		{
			expandToFillEvenly: true
			spacing: 3
		}
	}
}