//Expected type: MasteryWeapon_TrialQueryResult
panel MasteryTrialCard
{
	bind root

	size: <460, 560>

	behavior Animator
	{
		tweenAnimations: [
			{
				name: "AnimateIn"
				tweens: [
					//Container
					{
						property: @panel/Container:Image.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container.positionY
						startValue: 600
						endValue: 0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					//Completed
					{
						property: @panel/Container/CompletedArt/CompletedTopLeft:Image.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/CompletedArt/CompletedBottomRight:Image.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/CompletedArt/CompletedGradient:Image.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/CompletedArt/CompletedOutline:Image.alpha
						startValue: 0.0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					//Checkbox
					{
						property: @panel/Container/Status/Checkbox/Box:Image.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Status/Checkbox/Outline:Image.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Status/Checkbox/CheckMark:Image.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Status/Checkbox/Lock:Image.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					//StatusText
					{
						property: @panel/Container/Status/StatusText/NotCompleted:Label.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Status/StatusText/Completed:Label.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					//Unlocked
					{
						property: @panel/Container/Unlocked/Top/Title/TitleUnlocked:Label.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Unlocked/Description:Label.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Unlocked/ProgressRui:AngledProgressBar.progressBarAlpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Unlocked/ProgressRui:AngledProgressBar.progressBgAlpha
						startValue: 0
						endValue: 0.6
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Unlocked/ProgressRui/ProgressText:FormatLabel.alpha
						startValue: 0
						endValue: 0.6
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					//Locked
					{
						property: @panel/Container/Locked/Lock:Image.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					},
					{
						property: @panel/Container/Locked/TitleLocked:FormatLabel.alpha
						startValue: 0
						endValue: 1.0
						duration: 0.25
			            curve: EASE_OUT_QUART
					}
//					,
//					{
//						property: @panel:Sound.play
//						startValue: false
//						endValue: true
//						duration: 0.01
//						curve: EASE_LINEAR
//					}
				]
			}
		]
	}

//	behavior Sound
//	{
//		sound: "UI_Menu_WeaponMastery_Trial_Cards"
//	}

	panel Container
	{
		anchor: CENTER
		size: <460, 560>

		behavior Image
		{
			bind *.trialData.isUnlocked -> PickAssetFromTwo( $"ui_image/rui/menu/mastery/mastery_trial_box_locked.rpak", $"ui_image/rui/menu/mastery/mastery_trial_box_unlocked.rpak" ) -> @this.assetPath
			useLocaleDirection: true
		}

		panel CompletedArt
		{
			bind *.trialData.isCompleted -> @this.visible

			size: <460, 560>
			anchor: CENTER

			panel CompletedTopLeft
			{
				size: <212, 44>
				anchor: TOP_LEFT
				pivot: <0.0, 0.0>
				position: <-2,-3>

				behavior Image
				{
					assetPath: $"ui_image/rui/menu/mastery/mastery_trialitem_topleft_base.rpak"
					colorRGB: <0.1254, 0.3215, 0.2078>
				}
			}

			panel CompletedBottomRight
			{
				size: <306, 18>
				anchor: BOTTOM_RIGHT
				pivot: <1.0, 1.0>
				position: <4, 2>

				behavior Image
				{
					assetPath: $"ui_image/rui/menu/mastery/mastery_trial_box_bottom_right_base.rpak"
					colorRGB: <0.1254, 0.3215, 0.2078>
				}
			}

			panel CompletedGradient
			{
				anchor: BOTTOM
				pivot: <0.5, 1.0>
				size: <464, 118>

				behavior Image
				{
					assetPath: $"ui_image/rui/menu/mastery/mastery_trial_box_completed_gradient.rpak"
					assetMaskPath: $"ui_image/rui/menu/mastery/mastery_trialitem_complete_gradient.rpak"
					colorRGB: <0.1254, 0.3215, 0.2078>
					alpha: 0.3
				}
			}

			panel CompletedOutline
			{
				size: <464, 570>
				anchor: CENTER

				behavior Image
				{
					assetPath: $"ui_image/rui/menu/mastery/mastery_trial_box_frame.rpak"
					colorRGB: <0.1254, 0.3215, 0.2078>
				}
			}
		}

		panel Status
		{
			anchor: TOP_LEFT
	        pivot: <0.0, 0.0>
	        position: <8, 7>
			useLocaleDirection: true

			behavior HorizontalContainer
	        {
	            spacing: 5
	            alignment: LEFT
	            fitContentHeight: true
				useLocaleDirection: true
	        }

	        panel Checkbox
			{
		        pivot: <0.5, 0.0>
				offsets: <0, 0, 0, 0>
				size: <25, 25>

				panel Box
				{
					offsets: <0, 0, 0, 0>
		            pivot: <0.0, 0.0>
					size: <25, 25>

					behavior Image
					{
						assetPath: $"ui_image/rui/menu/mastery/weaponmastery_square_box.rpak"
					}
				}

				panel Outline
				{
					offsets: <0, 0, 0, 0>
		            pivot: <0.0, 0.0>
					size: <25, 25>

					behavior Image
					{
						assetPath: $"ui_image/rui/menu/mastery/weaponmastery_square_thick_outline.rpak"
						alpha: 1.0
						colorRGB: <0.31, 0.31, 0.31>
					}
				}

				panel CheckMark
				{
					bind *.trialData.isCompleted -> @this.visible

					anchor: BOTTOM_LEFT
					offsets: <0, 0, 0, 0>
					position: <2, -2>
		            pivot: <0.0, 1.0>
					size: <28, 28>

					behavior Image
					{
						assetPath: $"ui_image/rui/menu/buttons/checked.rpak"
						alpha: 1.0
						colorRGB: <0.42, 1.0, 0.0>
					}
				}

				panel Lock
				{
					bind *.trialData.isUnlocked -> Not -> @this.visible

					anchor: CENTER
					offsets: <0, 0, 0, 0>
		            pivot: <0.5, 0.5>
					size: <40, 40>
					position: <0, -5>

					behavior Image
					{
						assetPath: $"ui_image/rui/menu/buttons/lock.rpak"
						alpha: 1.0
						colorRGB: <0.56, 0.56, 0.56>
					}
				}
			}

			panel StatusText
			{
		        pivot: <0.5, 0.0>
				offsets: <0, 0, 0, 0>
				size: <140, 40>

				behavior FitToContent

				panel NotCompleted
				{
					bind *.trialData.isCompleted -> Not -> @this.visible

					anchor: LEFT
					offsets: <0, 0, 0, 0>
		            pivot: <0.0, 0.5>
					height: 25

					behavior Label
					{
						bind *.trialData.isUnlocked -> PickStringFromTwo( "#LOCKED", "#UNLOCKED" ) -> @this.text

						text: ""
						pixelHeight: 25
						textAlignHorizontal: LEFT
						allCaps: true
						horizontalMode: SQUISH_TO_CONTAINER
						colorRGB: <0.5529, 0.5529, 0.5529>
						useLocaleDirection: true
					}
			    }

			    panel Completed
				{
					anchor: LEFT
					offsets: <0, 0, 0, 0>
		            pivot: <0.0, 0.5>
					height: 25

					behavior Label
					{
						bind *.trialData.isCompleted -> PickStringFromTwo( "", "#MASTERY_COMPLETED_TRIAL" ) -> @this.text
						bind *.trialData.isCompleted -> PickFloatFromTwo( 0.0, 1.0 ) -> @this.alpha

						text: ""
						pixelHeight: 25
						textAlignHorizontal: LEFT
						horizontalMode: SQUISH_TO_CONTAINER
						allCaps: true
						colorRGB: <0.5529, 0.5529, 0.5529>
						useLocaleDirection: true
					}
			    }
		    }
		}

		panel Unlocked
		{
			bind *.trialData.isUnlocked -> @this.visible

			anchor: CENTER_STRETCH_WIDTH_HEIGHT
			size: <460, 560>
			offsets: <0, 0, 0, 0>
			offsetsTB: <65, 0>

			panel Top
			{
				anchor: TOP_STRETCH_WIDTH
				pivot: < 0.5, 0.0>
				offsets: <0, 0, 0, 0>

		        behavior VerticalContainer
		        {
		            spacing: 20
		            alignment: TOP
		            fitContentHeight: true
		        }

				instance $"ui_rtk/menus/mastery/components/mastery_trial_icon.rpak"
				{
					override bind root "*"

					size: <135, 116>
				}

				panel Title
				{
					anchor: CENTER_STRETCH_WIDTH
					offsetsLR: <40, 40>

					panel TitleUnlocked
					{
						anchor: CENTER_STRETCH_WIDTH
						offsets: <0, 0, 0, 0>

						behavior Label
						{
							bind *.trialConfig.name -> @this.text

							text: ""
							pixelHeight: 40
							textAlignHorizontal: CENTER
							allCaps: true
							face: "DefaultBoldFont"
						}
					}
				}
			}

			panel Description
			{
				anchor: BOTTOM_STRETCH_WIDTH
				size: <400, 25>
				offsetsLR: <40, 40>
				positionY: -250
				pivot: <0.5, 0.0>

				behavior Label
				{
					bind *.trialConfig.description -> @this.text

					text: ""
					textAlignHorizontal: CENTER
					textAlignVertical: TOP
					verticalMode: AUTOSIZE_TO_TEXT
					pixelHeight: 28
					margin: <0, 10, 0, 10>
					colorRGB: <0.55, 0.55, 0.55>
				}
			}

			panel ProgressRui
			{
				anchor: BOTTOM_STRETCH_WIDTH
				size: <400, 25>
				offsetsLR: <40, 40>
				positionY: -130
				pivot: <0.5, 1.0>

				behavior AngledProgressBar
				{
					bind *.trialData.currentValue -> @this.current
					bind *.trialConfig.goal -> @this.max
					bind *.trialData.isCompleted -> PickVectorFromTwo(<0.4627, 0.3686, 0.1176>, <0.9215, 0.7843, 0.2980>) -> @this.progressBarColor

					progressBarColor: <0.9215, 0.7843, 0.298>
					progressBarAlpha: 1.0
					progressBgColor: <0.2823, 0.2549 ,0.1568>
					progressBgAlpha: 0.6
					angle: 45
				}

				panel ProgressText
				{
					anchor: LEFT
					size: <400, 25>
					pivot: <0, 0.5>
					useLocaleDirection: true

					behavior FormatLabel
					{
						bind *.trialData.currentValue -> @this.arg1
						bind *.trialConfig.goal -> @this.arg2
						bind *.trialData.isCompleted -> PickStringFromTwo( "#X/Y", "#MASTERY_COMPLETED_TRIAL" ) -> @this.format

						format: ""
						face: "DefaultBoldFont"
						textAlignHorizontal: LEFT
						pixelHeight: 25
						colorRGB: <0, 0, 0>
						margin: <10, 10, 0, 0>
						arg1: "0"
						arg2: "0"
						useLocaleDirection: true
					}
				}
			}

		    panel RewardsContainer
			{
				anchor: BOTTOM_STRETCH_WIDTH
				offsets: <0, 0, 0, 0>
				pivot: <0.5, 1.0>
				offsetRight: 10
				offsetLeft: 10
				positionY: -8

				behavior HorizontalContainer
				{
					fitContentHeight: true
					spacing: 12
					alignment: BOTTOM_RIGHT
					useLocaleDirection: true
				}

				behavior ListBinder
				{
					bind *.trialData.isUnlocked -> PickStringFromTwo( "", "*.rewards" ) -> @this.bindingPath

					bindingPath: ""
					prefab: $"ui_rtk/common/buttons/battlepass_reward_button_small.rpak"
				}
			}
	    }

		panel Locked
		{
			bind *.trialData.isUnlocked -> Not -> @this.visible

			anchor: CENTER_STRETCH_WIDTH
	        pivot: <0.5, 0.5>
			offsets: <0, 0, 0, 0>
			offsetsLR: <80, 80>

	        behavior VerticalContainer
	        {
	            spacing: 20
	            alignment: TOP
	            fitContentHeight: true
	        }

			panel Lock
			{
				size: <116, 144>

				behavior Image
				{
					assetPath: $"ui_image/rui/menu/mastery/mastery_lock_large.rpak"
					alpha: 1.0
					colorRGB: <0.56, 0.56, 0.56>
				}
			}

			panel TitleLocked
			{
				anchor: CENTER_STRETCH_WIDTH
				offsets: <0, 0, 0, 0>

				behavior FormatLabel
				{
					bind *.trialConfig.displayLevel -> @this.arg1
					bind *.trialData.isUnlocked -> PickFloatFromTwo( 1.0, 0.0 ) -> @this.alpha

					format: "#MASTERY_GET_TO_LEVEL"
					pixelHeight: 35
					textAlignHorizontal: CENTER
					arg1: ""
					allCaps: true
				}
			}
	    }
	}
}
