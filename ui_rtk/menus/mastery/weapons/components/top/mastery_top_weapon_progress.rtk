panel MasteryiconProgress
{
	bind root

	size: <135, 80>
	inputListener: true

	behavior Button
    {
        soundHighlighted: "ui_menu_focus"
		soundPressedEnabled: "ui_menu_accept"

        transitions: [
            {
				fromState: HIGHLIGHTED
				toState: IDLE
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/Backplate:Image.colorRGB
                value: <1, 1, 1>
            },
            {
				fromState: IDLE
				toState: HIGHLIGHTED
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/Backplate:Image.colorRGB
                value: <0.9215, 0.7843, 0.298>
            }
        ]
    }

    panel Container
	{
		anchor: TOP
        pivot: <0.5, 0.0>

        behavior VerticalContainer
        {
            spacing: 9
            alignment: TOP
        }

        panel Backplate
		{
			pivot: <0.5, 1.0>
			offsets: <0, 0, 0, 0>
			size: <125, 56>

			behavior Image
			{
	            bind *.icon -> @this.assetPath

				colorRGB: <1, 1, 1>
	            alpha: 0.9
	        }
		}

		panel BarContainer
		{
			pivot: <0.5, 1.0>
			anchor: BOTTOM_STRETCH_WIDTH
			size: <1, 6>
			offsets: <0, 0, 0, 0>

			behavior AngledProgressBar
			{
				bind *.progress -> @this.current

				progressBarColor: <0.9215, 0.7843, 0.298>
				progressBarAlpha: 1.0
				progressBgColor: <0.0, 0.0, 0.0>
				progressBgAlpha: 0.6
				max: 1.0
				angle: 30
			}
		}
    }
}