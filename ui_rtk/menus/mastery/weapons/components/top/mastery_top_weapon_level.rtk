panel MasteryiconProgress
{
	bind root

	size: <135, 80>
	inputListener: true

	behavior Button
    {
        soundHighlighted: "ui_menu_focus"
		soundPressedEnabled: "ui_menu_accept"

        transitions: [
            {
				fromState: HIGHLIGHTED
				toState: IDLE
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/Backplate:Image.colorRGB
                value: <1, 1, 1>
            },
            {
				fromState: HIGHLIGHTED
				toState: IDLE
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/LevelContainer:FormatLabel.colorRGB
                value: <0.698, 0.709, 0.733>
            },
            {
				fromState: IDLE
				toState: HIGHLIGHTED
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/Backplate:Image.colorRGB
                value: <0.9215, 0.7843, 0.298>
            },
            {
				fromState: IDLE
				toState: HIGHLIGHTED
                type: TRANSITION_PROPERTY_SET
                property: @panel/Container/LevelContainer:FormatLabel.colorRGB
                value: <0.9215, 0.7843, 0.298>
            }
        ]
    }

    panel Container
	{
		anchor: TOP
        pivot: <0.5, 0.0>

        behavior VerticalContainer
        {
            spacing: 0
            alignment: TOP
        }

        panel Backplate
		{
			pivot: <0.5, 1.0>
			offsets: <0, 0, 0, 0>
			size: <125, 56>

			behavior Image
			{
	            bind *.icon -> @this.assetPath

				colorRGB: <1, 1, 1>
	            alpha: 0.9
	        }
		}

		panel LevelContainer
		{
			pivot: <0.5, 1.0>
			anchor: BOTTOM_STRETCH_WIDTH
			size: <1, 6>
			offsets: <0, 0, 0, 0>

			behavior FormatLabel
			{
				bind *.level -> @this.arg1

				format: "#HUD_LEVEL_N"
				pixelHeight: 25
				allCaps: true
				textAlignHorizontal: CENTER
				horizontalMode: SQUISH_TO_CONTAINER
				colorRGB: <0.698, 0.709, 0.733>
				shadowAlpha: 0.6
				shadowBlur: 6.0
				shadowOffset: <0, 0>
				arg1:""
			}
		}
    }
}