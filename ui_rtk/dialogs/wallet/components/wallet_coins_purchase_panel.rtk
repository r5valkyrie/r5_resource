panel WalletCoinsPurchasePanel
{
	bind root

	anchor: CENTER_STRETCH_WIDTH_HEIGHT
	offsets: <0, 0, 0, 0>

	behavior WalletCoinsPurchasePanel
	{
		currencyType: 0
	}

	panel Container
	{
		anchor: CENTER_STRETCH_WIDTH
		pivot: <0.5, 0.5>
		positionY: 0

		behavior GridContainer
		{
			defaultSlotSize: <252, 239>
			slotSpacing: <8, 7>
			wrapAfterSlot: 2
			startCorner: TOP_LEFT
			fillDirection: COLUMN_FIRST
			gridSlotAnchor: CENTER
			isStrictGrid: true
		}

		behavior ListBinder
		{
			bindingPath: "*.itemsArray"

			prefab:$"ui_rtk/dialogs/wallet/components/wallet_currency_purchase_button.rpak"
		}
	}

	panel DiscountPanel
	{
		bind *.discountText -> IsEmpty -> NOT -> @this.visible
		anchor: CENTER
		pivot: <1, 0.5>
		positionX: -147
		positionY: 330
		width: 500
		height: 80

		panel ImageContainer
		{
			anchor: TOP_LEFT
			pivot: <0, 0>
			positionX: -10
			width: 100
			height: 44

			behavior Image
			{
				bind *.discountImage -> @this.assetPath
			}
		}

		panel LabelContainer
		{
			anchor: TOP_LEFT
			pivot: <0, 0>
			positionY: 11
			positionX: 91
			width: 500
			height: 80

			behavior Label
			{
				bind *.discountText -> @this.text
				face: "TitleRegularFont"
				textAlignHorizontal: LEFT
				horizontalMode: WRAP
				verticalMode: AUTOSIZE_TO_TEXT
				pixelHeight: 21.6
				allCaps: true
				leading: 1.0
				color: <1, 1, 1, 1>
			}
	    }
	}

	panel TaxNoticeMessage
	{
		bind *.taxNoticeMessage -> IsEmpty -> NOT -> @this.visible

		anchor: CENTER
		pivot: <1, 0.5>
		positionX: 645
		positionY: 312
		width: 400
		height: 80

		behavior Label
		{
			bind *.taxNoticeMessage -> @this.text
			face: "TitleRegularFont"
			textAlignHorizontal: RIGHT
			horizontalMode: WRAP
			verticalMode: AUTOSIZE_TO_TEXT
			pixelHeight: 21.6
			leading: 1.0
			color: <1, 1, 1, 1>
		}
	}

	panel GiftDisclaimer
	{
		bind *.giftDisclaimer -> IsEmpty -> NOT -> @this.visible

		anchor: CENTER
		pivot: <1, 0.5>
		positionX: 567
		positionY: 262
		width: 1150
		height: 80

		behavior Label
		{
			bind *.giftDisclaimer -> @this.text
			face: "TitleRegularFont"
			textAlignHorizontal: CENTER
			verticalMode: AUTOSIZE_TO_TEXT
			pixelHeight: 21.6
			leading: 1.0
			color: <1, 1, 1, 1>
		}
	}
}